window.preloaded = window.preloaded || {};
window._bubble_watcher_cache = {"bTGYf":{"statics":{"title":true,"backdropBackgroundData":true,"containerClass":true,"id":true},"styles":{"6":{},"12":{"opacity":1}},"props":{"title":"سعر اليوم | أسعار العملات والذهب","backdropBackgroundData":{"is_backdrop":true,"background_style":"gradient","bgcolor":"var(--color_background_default)","background_gradient_direction":"top","background_gradient_from":"var(--color_surface_default)","background_gradient_mid":null,"background_gradient_to":"var(--color_background_default)","background_image":null,"center_background":null,"crop_responsive":null,"background_size_cover":null,"repeat_background_vertical":null,"repeat_background_horizontal":null,"background_color_if_empty_image":"rgba(255, 255, 255, 0.0)","background_gradient_style":"linear","background_radial_gradient_shape":"ellipse","background_radial_gradient_size":"farthest-corner","background_radial_gradient_xpos":10,"background_radial_gradient_ypos":10,"background_gradient_custom_angle":45,"backdrop_paralax_speed":0.2,"backdrop_image_paralax":false},"containerClass":"bubble-r-container flex column"},"preCached":{"shouldAddWrapper":false}},"ix_prices_html":{"statics":{"html":true,"useIframe":true,"id":true},"styles":{"0":{},"6":{"opacity":1},"12":{}},"props":{"html":"<div id=\"sy-app\" dir=\"rtl\" lang=\"ar\">\n<style>\n#sy-app{--bg:#0D1B2A;--sf:#14283D;--sf2:#102E42;--tx:#EAF2FA;--mu:#ADC1D5;--kk:#8FAEC9;--pr:#1E6FD9;--ac:#00C896;--gd:#FFD28A;--er:#FF9CA6;--bd:rgba(234,242,250,.16);\n font-family:'Tajawal','Noto Sans Arabic',system-ui,sans-serif;color:var(--tx);width:100%;box-sizing:border-box;padding:32px 20px 48px;direction:rtl;text-align:right}\n#sy-app *{box-sizing:border-box}\n#sy-app .wrap{max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:28px}\n#sy-app .kick{font-size:12px;letter-spacing:.12em;color:var(--kk);text-transform:uppercase;direction:ltr;text-align:right}\n#sy-app h1{font-family:'Noto Sans Arabic','Tajawal',sans-serif;font-size:36px;line-height:1.3;margin:0}\n#sy-app h2{font-family:'Noto Sans Arabic','Tajawal',sans-serif;font-size:24px;margin:0}\n#sy-app h3{font-size:18px;margin:0}\n#sy-app .mu{color:var(--mu);font-size:14px;line-height:1.7;margin:0}\n#sy-app .row{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between}\n#sy-app .btn{font:inherit;font-size:15px;font-weight:700;border-radius:10px;padding:11px 20px;cursor:pointer;border:1px solid transparent;transition:opacity .2s}\n#sy-app .btn:disabled{opacity:.6;cursor:wait}\n#sy-app .btn-p{background:var(--pr);color:#fff}\n#sy-app .btn-g{background:transparent;color:var(--tx);border-color:rgba(234,242,250,.5)}\n#sy-app .status{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--mu)}\n#sy-app .spin{width:18px;height:18px;border:2px solid rgba(234,242,250,.25);border-top-color:var(--ac);border-radius:50%;animation:syspin .8s linear infinite;display:none}\n#sy-app.busy .spin{display:inline-block}\n@keyframes syspin{to{transform:rotate(360deg)}}\n#sy-app .err{display:none;background:rgba(255,156,166,.1);border:1px solid rgba(255,156,166,.4);color:var(--er);border-radius:10px;padding:12px 16px;font-size:14px}\n#sy-app .err.on{display:block}\n#sy-app .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}\n#sy-app .card{background:var(--sf);border:1px solid var(--bd);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:6px}\n#sy-app .card.gold{background:#132D36;border-color:#287669}\n#sy-app .card .lbl{font-size:15px}\n#sy-app .card .val{font-size:30px;font-weight:700;color:#F0F7FF;direction:ltr;text-align:right;font-variant-numeric:tabular-nums}\n#sy-app .card.gold .val{color:var(--gd)}\n#sy-app .card .tm{font-size:12px;color:var(--mu)}\n#sy-app .panel{background:var(--sf);border:1px solid var(--bd);border-radius:16px;padding:22px;display:flex;flex-direction:column;gap:14px}\n#sy-app .fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}\n#sy-app label{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--kk);font-weight:700}\n#sy-app input,#sy-app select{font:inherit;font-size:16px;color:var(--tx);background:var(--bg);border:1px solid rgba(234,242,250,.24);border-radius:10px;padding:11px 12px;min-height:46px;width:100%}\n#sy-app input{direction:ltr;text-align:right}\n#sy-app input:focus,#sy-app select:focus{outline:none;border-color:var(--pr);box-shadow:0 0 0 3px rgba(30,111,217,.22)}\n#sy-app .res{background:var(--sf2);border-radius:12px;padding:16px;font-size:22px;font-weight:700;color:var(--ac);min-height:58px}\n#sy-app .res.wait{font-size:14px;font-weight:400;color:var(--mu)}\n#sy-app .ferr{color:var(--er);font-size:13px;display:none}\n#sy-app footer{border-top:1px solid var(--bd);padding-top:20px;display:flex;flex-direction:column;gap:6px}\n#sy-app footer a{color:#90BEFF}\n@media(max-width:600px){#sy-app h1{font-size:28px}#sy-app .card .val{font-size:26px}#sy-app{padding:24px 14px 40px}}\n</style>\n<div class=\"wrap\">\n <section style=\"display:flex;flex-direction:column;gap:12px\">\n  <div class=\"kick\">MARKET WATCH / USD · ILS · JOD</div>\n  <div class=\"row\">\n   <h1>العملات والذهب، في مكان واحد</h1>\n   <button type=\"button\" class=\"btn btn-p\" id=\"sy-refresh\">تحديث الأسعار</button>\n  </div>\n  <p class=\"mu\">أسعار مرجعية عالمية وتحويل فوري بين الدولار والشيقل والدينار، مع أسعار جرام الذهب بعيارات 24 و21 و18.</p>\n  <p class=\"mu\">تحديث تلقائي كل 60 ثانية · بدون أي مفتاح خدمة.</p>\n  <div class=\"status\"><span class=\"spin\"></span><span id=\"sy-status\">جارٍ جلب أحدث بيانات السوق…</span></div>\n  <div class=\"err\" id=\"sy-err\" role=\"alert\"></div>\n </section>\n\n <section style=\"display:flex;flex-direction:column;gap:14px\">\n  <h2>أسعار العملات</h2>\n  <div class=\"grid\" id=\"sy-fx\"></div>\n </section>\n\n <section class=\"panel\">\n  <div class=\"kick\">CURRENCY EXCHANGE</div>\n  <h2>محول العملات</h2>\n  <p class=\"mu\">اختر العملتين وأدخل المبلغ. تُحتسب النتيجة مباشرة من أحدث سعر متاح.</p>\n  <div class=\"fields\">\n   <label>المبلغ<input id=\"sy-amt\" type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\" value=\"100\"></label>\n   <label>من<select id=\"sy-from\"><option value=\"USD\" selected>USD · دولار أمريكي</option><option value=\"ILS\">ILS · شيقل إسرائيلي</option><option value=\"JOD\">JOD · دينار أردني</option></select></label>\n   <label>إلى<select id=\"sy-to\"><option value=\"USD\">USD · دولار أمريكي</option><option value=\"ILS\" selected>ILS · شيقل إسرائيلي</option><option value=\"JOD\">JOD · دينار أردني</option></select></label>\n  </div>\n  <div><button type=\"button\" class=\"btn btn-g\" id=\"sy-swap\">⇅ تبديل العملات</button></div>\n  <div class=\"ferr\" id=\"sy-amt-err\">أدخل مبلغاً صالحاً أكبر من أو يساوي صفر.</div>\n  <div class=\"res wait\" id=\"sy-conv\">تظهر نتيجة التحويل بعد وصول الأسعار.</div>\n  <p class=\"mu\">السعر مرجعي ولا يشمل عمولة البنك أو الصراف.</p>\n </section>\n\n <section style=\"display:flex;flex-direction:column;gap:14px\">\n  <h2>سوق الذهب</h2>\n  <p class=\"mu\">سعر الجرام العالمي · دون مصنعية أو ضرائب · الأوقية الترويسية = 31.1034768 جرام.</p>\n  <div class=\"grid\" id=\"sy-gold\"></div>\n  <div class=\"panel\">\n   <h3>احسب قيمة الذهب</h3>\n   <div class=\"fields\">\n    <label>الوزن<input id=\"sy-w\" type=\"number\" min=\"0\" step=\"any\" inputmode=\"decimal\" value=\"10\"></label>\n    <label>العيار<select id=\"sy-k\"><option value=\"1\">عيار 24</option><option value=\"0.875\" selected>عيار 21</option><option value=\"0.75\">عيار 18</option></select></label>\n    <label>وحدة الوزن<select id=\"sy-u\"><option value=\"1\" selected>جرام</option><option value=\"31.1034768\">أوقية</option><option value=\"1000\">كيلوجرام</option></select></label>\n   </div>\n   <div class=\"ferr\" id=\"sy-w-err\">أدخل وزناً صالحاً أكبر من أو يساوي صفر.</div>\n   <div class=\"res wait\" id=\"sy-gcalc\">تظهر القيمة بعد وصول سعر الذهب.</div>\n  </div>\n </section>\n\n <footer>\n  <h3>مصادر البيانات والمنهجية</h3>\n  <p class=\"mu\">أسعار العملات من <a href=\"https://www.exchangerate-api.com/docs/free\" target=\"_blank\" rel=\"noopener\">ExchangeRate-API (الواجهة المفتوحة)</a>، وتتحدث تقريباً مرة يومياً؛ والأسعار المتقاطعة محسوبة من الدولار. سعر الذهب من <a href=\"https://gold-api.com\" target=\"_blank\" rel=\"noopener\">gold-api.com</a> وهو شبه لحظي.</p>\n  <p class=\"mu\">البيانات مرجعية للمعلومات فقط، وليست توصية مالية.</p>\n </footer>\n</div>\n<script>\n(function(){\n if(window.__syPrices){window.__syPrices.init();return;}\n var OZ=31.1034768;\n var S={r:null,rt:null,g:null,gt:null,busy:false,timer:null};\n var NAMES={USD:'دولار أمريكي',ILS:'شيقل',JOD:'دينار أردني'};\n var LBL={USD:'الدولار',ILS:'الشيقل',JOD:'الدينار'};\n var PAIRS=[['USD','ILS'],['JOD','ILS'],['JOD','USD'],['ILS','USD'],['ILS','JOD'],['USD','JOD']];\n var KARATS=[[24,1],[21,0.875],[18,0.75]];\n function $(id){return document.getElementById(id);}\n function fmt(n,d){if(n==null||!isFinite(n))return '—';return n.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});}\n function dt(d){if(!d)return '';try{return d.toLocaleString('ar-EG',{dateStyle:'medium',timeStyle:'short'});}catch(e){return d.toLocaleString();}}\n function rate(a,b){if(!S.r)return null;var ra=a==='USD'?1:S.r[a],rb=b==='USD'?1:S.r[b];if(!ra||!rb)return null;return rb/ra;}\n function card(cls,code,label,val,unit,time){return '<div class=\"card'+cls+'\"><div class=\"kick\">'+code+'</div><div class=\"lbl\">'+label+'</div><div class=\"val\">'+val+'</div><div class=\"mu\">'+unit+'</div><div class=\"tm\">'+time+'</div></div>';}\n function renderFx(){var h='';PAIRS.forEach(function(p){var v=rate(p[0],p[1]);var t=S.rt?'آخر تحديث من المصدر · '+dt(S.rt):(S.busy?'جارٍ التحميل…':'بانتظار بيانات السوق');h+=card('',p[0]+' / '+p[1],LBL[p[0]]+' مقابل '+LBL[p[1]],v==null?'…':fmt(v,4),NAMES[p[1]]+' لكل 1 '+NAMES[p[0]],t);});$('sy-fx').innerHTML=h;}\n function renderGold(){var h='';var g=S.g?S.g/OZ:null;var ils=rate('USD','ILS');KARATS.forEach(function(k){var t=S.gt?'آخر تحديث من المصدر · '+dt(S.gt):(S.busy?'جارٍ التحميل…':'بانتظار بيانات السوق');var u=g==null?null:g*k[1];var i=(u==null||ils==null)?null:u*ils;h+=card(' gold','GOLD · '+k[0]+'K / USD','جرام ذهب عيار '+k[0],u==null?'…':fmt(u,2),'دولار أمريكي / جرام',t);h+=card(' gold','GOLD · '+k[0]+'K / ILS','جرام ذهب عيار '+k[0],i==null?'…':fmt(i,2),'شيقل / جرام',t);});$('sy-gold').innerHTML=h;}\n function conv(){var a=parseFloat($('sy-amt').value),f=$('sy-from').value,t=$('sy-to').value,o=$('sy-conv'),e=$('sy-amt-err');var bad=$('sy-amt').value!==''&&(!isFinite(a)||a<0);e.style.display=bad?'block':'none';var r=rate(f,t);if(r==null){o.className='res wait';o.textContent='تظهر نتيجة التحويل بعد وصول الأسعار.';return;}if(bad||$('sy-amt').value===''){o.className='res wait';o.textContent='أدخل المبلغ لعرض النتيجة.';return;}o.className='res';o.textContent=fmt(a,2)+' '+f+' = '+fmt(a*r,2)+' '+t+'  (1 '+f+' = '+fmt(r,4)+' '+t+')';}\n function gcalc(){var w=parseFloat($('sy-w').value),k=parseFloat($('sy-k').value),u=parseFloat($('sy-u').value),o=$('sy-gcalc'),e=$('sy-w-err');var bad=$('sy-w').value!==''&&(!isFinite(w)||w<0);e.style.display=bad?'block':'none';if(!S.g){o.className='res wait';o.textContent='تظهر القيمة بعد وصول سعر الذهب.';return;}if(bad||$('sy-w').value===''){o.className='res wait';o.textContent='أدخل الوزن لعرض القيمة.';return;}var usd=w*u*(S.g/OZ)*k;var ils=rate('USD','ILS');o.className='res';o.textContent='القيمة المرجعية: '+fmt(usd,2)+' USD'+(ils!=null?'  |  '+fmt(usd*ils,2)+' ILS':'');}\n function renderAll(){renderFx();renderGold();conv();gcalc();}\n function setBusy(b){S.busy=b;var app=$('sy-app');if(app)app.classList.toggle('busy',b);var btn=$('sy-refresh');if(btn)btn.disabled=b;}\n function getJSON(u){return fetch(u,{cache:'no-store'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();});}\n function load(){if(S.busy||!$('sy-app'))return;setBusy(true);$('sy-status').textContent='جارٍ جلب أحدث بيانات السوق…';renderAll();\n  var fx=getJSON('https://open.er-api.com/v6/latest/USD').then(function(d){if(!d||d.result!=='success'||!d.rates||!d.rates.ILS||!d.rates.JOD)throw new Error('bad');S.r={ILS:d.rates.ILS,JOD:d.rates.JOD};S.rt=d.time_last_update_unix?new Date(d.time_last_update_unix*1000):new Date();});\n  var gd=getJSON('https://api.gold-api.com/price/XAU').then(function(d){var p=d&&parseFloat(d.price);if(!p||!isFinite(p))throw new Error('bad');S.g=p;S.gt=d.updatedAt?new Date(d.updatedAt):new Date();});\n  Promise.allSettled([fx,gd]).then(function(rs){setBusy(false);var m=[];if(rs[0].status!=='fulfilled')m.push('أسعار العملات');if(rs[1].status!=='fulfilled')m.push('سعر الذهب');var e=$('sy-err');if(m.length){e.textContent='تعذر تحديث '+m.join(' و')+'. تحقق من اتصال الإنترنت ثم أعد المحاولة؛ ستتم المحاولة تلقائياً خلال دقيقة.'+((S.r||S.g)?' المعروض هو آخر سعر تم جلبه بنجاح.':'');e.classList.add('on');}else{e.textContent='';e.classList.remove('on');}$('sy-status').textContent='آخر محاولة تحديث: '+dt(new Date())+' · التحديث التالي خلال 60 ثانية';renderAll();});}\n function bind(){[['sy-amt','input',conv],['sy-from','change',conv],['sy-to','change',conv],['sy-w','input',gcalc],['sy-k','change',gcalc],['sy-u','change',gcalc]].forEach(function(b){var el=$(b[0]);if(el&&!el.__sy){el.__sy=1;el.addEventListener(b[1],b[2]);}});var sw=$('sy-swap');if(sw&&!sw.__sy){sw.__sy=1;sw.addEventListener('click',function(){var f=$('sy-from'),t=$('sy-to'),x=f.value;f.value=t.value;t.value=x;conv();});}var rb=$('sy-refresh');if(rb&&!rb.__sy){rb.__sy=1;rb.addEventListener('click',load);}}\n function init(){if(!$('sy-app'))return;bind();renderAll();load();}\n window.__syPrices={init:init};\n S.timer=setInterval(function(){if(document.visibilityState!=='hidden')load();},60000);\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();\n})();\n</scr" + "ipt>\n</div>\n","useIframe":false},"preCached":{"deferDrawing":null}},"bTGYf_fill":{"statics":{"containerClass":true,"id":true},"styles":{"0":{"overflow":"visible"},"2":{},"8":{"opacity":1},"14":{}},"props":{"containerClass":"bubble-r-container flex column"},"preCached":{"shouldAddWrapper":false}},"ix_nav_bar":{"statics":{"containerClass":true,"id":true},"styles":{"0":{"overflow":"visible"},"2":{},"8":{"opacity":1},"14":{}},"props":{"containerClass":"bubble-r-container flex column"},"preCached":{"shouldAddWrapper":false}},"nav_header_in":{"statics":{"containerClass":true,"id":true},"styles":{"0":{"overflow":"visible"},"2":{},"8":{"opacity":1},"14":{}},"props":{"containerClass":"bubble-r-container flex row"},"preCached":{"shouldAddWrapper":false}},"hdr_asof":{"statics":{"useDotDotDot":true,"verticalCenter":true,"id":true},"styles":{"1":{},"11":{"opacity":1},"17":{}},"props":{"textData":{"html":""},"useDotDotDot":false,"verticalCenter":false},"preCached":{"tagName":"div"}},"hdr_market_mark":{"statics":{"icon":true,"spin":true,"tabIndex":true,"id":true},"styles":{"1":{},"7":{"opacity":1},"13":{}},"props":{"icon":{"set":"phosphor","variant":"regular","icon":"chart-line-up"},"tabIndex":""}},"nav_header_brand":{"statics":{"text":true,"useDotDotDot":true,"noHtml":true,"editor_preview_link":true,"backgroundStyle":true,"verticalCenter":true,"target":true,"rel":true,"id":true},"styles":{"2":{},"4":{"font-family":"var(--font_default)","font-size":"18px","font-weight":"700","color":"var(--color_text_default)","text-align":"right"},"11":{"opacity":1},"17":{}},"props":{"text":"سعر اليوم","useDotDotDot":false,"backgroundStyle":"none","verticalCenter":false,"target":"_self"},"preCached":{"showIcon":null}},"nav_header_spacer":{"statics":{"containerClass":true,"id":true},"styles":{"0":{"overflow":"visible"},"2":{},"8":{"opacity":1},"14":{}},"props":{"containerClass":"bubble-r-container flex column"},"preCached":{"shouldAddWrapper":false}},"ix_typography":{"statics":{"html":true,"useIframe":true,"id":true},"styles":{"0":{},"6":{"opacity":1},"12":{}},"prop